---
import App from '../../layouts/App.astro';
import ActionNotice from '../../components/ActionNotice.astro';
import { actions } from 'astro:actions';
import { db } from '../../lib/guard';
import { loadCriteriaForAhp, listScenarios } from '../../lib/ahp/scenario';
import { CONSISTENCY_THRESHOLD, MAX_CRITERIA } from '../../lib/ahp/ahp';
import { formatDateTime, formatNumber } from '../../lib/format';

const user = Astro.locals.user!;
if (user.role !== 'admin') return Astro.redirect('/ahp', 303);

const list = await loadCriteriaForAhp(db);
const scenarios = await listScenarios(db, 20);

const saveResult = Astro.getActionResult(actions.ahp.save);
const removeResult = Astro.getActionResult(actions.ahp.remove);

const canPair = list.length >= 2 && list.length <= MAX_CRITERIA;

// Daftar pasangan segitiga atas, dipakai untuk merender input.
const pairs: { i: number; j: number; row: string; col: string; index: number }[] = [];
if (canPair) {
  let k = 0;
  for (let i = 0; i < list.length; i++) {
    for (let j = i + 1; j < list.length; j++) {
      pairs.push({ i, j, row: list[i].code, col: list[j].code, index: k++ });
    }
  }
}

/** Pilihan skala Saaty, termasuk kebalikannya. */
const scale = [9, 8, 7, 6, 5, 4, 3, 2, 1, 1 / 2, 1 / 3, 1 / 4, 1 / 5, 1 / 6, 1 / 7, 1 / 8, 1 / 9];

const labelOf = (value: number): string => {
  if (value === 1) return '1 sama penting';
  if (value > 1) return formatNumber(value, 0) + ' lebih penting';
  return '1/' + formatNumber(1 / value, 0) + ' kurang penting';
};
---

<App
  title="AHP"
  page="AHP"
  lead="Perbandingan berpasangan antar kriteria menghasilkan bobot. Bobot disimpan sebagai skenario, tidak menimpa bobot kriteria."
>
  <Fragment slot="actions">
    <a class="button button--quiet" href="/kriteria">Lihat kriteria</a>
  </Fragment>

  <div class="stack">
    <ActionNotice
      success={saveResult?.data ? 'Skenario tersimpan.' : removeResult?.data ? 'Skenario dihapus.' : null}
      error={saveResult?.error ?? removeResult?.error}
    />

    <div class="notice notice--info" role="status">
      <span class="notice__title">Cara kerja</span>
      Isi seberapa penting kriteria kiri dibanding kriteria atas. Sistem melengkapi kebalikannya secara otomatis, lalu
      menghitung bobot dan memeriksa konsistensi. Nilai CR di bawah {CONSISTENCY_THRESHOLD} berarti penilaian tidak
      saling bertentangan. Itu bukan ukuran benar atau salahnya penilaian, hanya ukuran konsistensi internal.
    </div>

    {!canPair ? (
      <section class="panel">
        <div class="empty-state">
          <p class="empty-state__title">Perbandingan belum bisa diisi</p>
          <p class="empty-state__body">
            Diperlukan minimal 2 dan maksimal {MAX_CRITERIA} kriteria. Saat ini ada {list.length} kriteria.
          </p>
          <a class="button button--primary" href="/kriteria">Kelola kriteria</a>
        </div>
      </section>
    ) : (
      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title" id="form-pairwise">Perbandingan berpasangan</h2>
          <p class="panel__meta">{pairs.length} pasangan dari {list.length} kriteria</p>
        </div>
        <div class="panel__body">
          <form method="post" action={actions.ahp.save} class="stack" id="ahp-form">
            <div class="field">
              <label class="field__label" for="scenario-name">Nama skenario</label>
              <input
                class="input"
                id="scenario-name"
                name="name"
                type="text"
                required
                minlength="3"
                maxlength="160"
                placeholder="Bobot AHP semester ganjil 2026"
              />
              <p class="field__hint">Nama ini muncul di daftar skenario dan dipakai saat memilih bobot.</p>
            </div>

            <input type="hidden" name="upper" id="upper-values" value="" />

            <div class="table-wrap">
              <table class="data-table" aria-labelledby="form-pairwise">
                <thead>
                  <tr>
                    <th scope="col">Kriteria</th>
                    <th scope="col">Dibandingkan dengan</th>
                    <th scope="col">Tingkat kepentingan</th>
                  </tr>
                </thead>
                <tbody>
                  {pairs.map((pair) => (
                    <tr>
                      <th scope="row"><span class="matrix-tag">{pair.row}</span></th>
                      <td><span class="matrix-tag">{pair.col}</span></td>
                      <td>
                        <select
                          class="select ahp-select"
                          data-index={pair.index}
                          aria-label={`Kepentingan ${pair.row} dibanding ${pair.col}`}
                        >
                          {scale.map((value) => (
                            <option value={value} selected={value === 1}>
                              {labelOf(value)}
                            </option>
                          ))}
                        </select>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="form-actions">
              <button class="button button--primary" type="submit">Hitung dan simpan skenario</button>
              <a class="button" href="/ahp">Muat ulang</a>
            </div>
          </form>
        </div>
      </section>
    )}

    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title" id="tabel-skenario">Skenario tersimpan</h2>
        <p class="panel__meta">{scenarios.length} skenario</p>
      </div>

      {scenarios.length === 0 ? (
        <div class="empty-state">
          <p class="empty-state__title">Belum ada skenario</p>
          <p class="empty-state__body">
            Setelah perbandingan diisi dan disimpan, skenario muncul di sini beserta bobot dan nilai CR-nya.
          </p>
        </div>
      ) : (
        <div class="panel__body panel__body--flush">
          <div class="table-wrap">
            <table class="data-table" aria-labelledby="tabel-skenario">
              <thead>
                <tr>
                  <th scope="col">Nama</th>
                  <th scope="col" class="num">Kriteria</th>
                  <th scope="col" class="num">CR</th>
                  <th scope="col">Status</th>
                  <th scope="col">Dibuat</th>
                  <th scope="col"><span class="visually-hidden">Tindakan</span></th>
                </tr>
              </thead>
              <tbody>
                {scenarios.map((s) => (
                  <tr data-scenario-id={s.id}>
                    <td>{s.name}</td>
                    <td class="num">{s.criteriaCount}</td>
                    <td class="num">{s.consistencyRatio === null ? '-' : formatNumber(s.consistencyRatio, 4)}</td>
                    <td>
                      {s.consistent ? (
                        <span>Konsisten</span>
                      ) : (
                        <span>CR {formatNumber(s.consistencyRatio ?? 0, 4)} di atas ambang</span>
                      )}
                    </td>
                    <td class="nowrap">{formatDateTime(s.createdAt)}</td>
                    <td>
                      <div class="cluster">
                        <a class="button button--quiet" href={`/ahp/${s.id}`}>Buka</a>
                        {user.role === 'admin' && (
                          <form
                            method="post"
                            action={actions.ahp.remove}
                            onsubmit="return confirm('Hapus skenario ini?')"
                          >
                            <input type="hidden" name="id" value={s.id} />
                            <button class="button button--quiet button--danger" type="submit">Hapus</button>
                          </form>
                        )}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </section>
  </div>
</App>

<script>
  const form = document.getElementById('ahp-form') as HTMLFormElement | null;
  const hidden = document.getElementById('upper-values') as HTMLInputElement | null;

  if (form && hidden) {
    form.addEventListener('submit', () => {
      const selects = Array.from(form.querySelectorAll<HTMLSelectElement>('.ahp-select'));
      const values = selects
        .slice()
        .sort((a, b) => Number(a.dataset.index) - Number(b.dataset.index))
        .map((s) => Number(s.value));
      hidden.value = JSON.stringify(values);
    });
  }
</script>
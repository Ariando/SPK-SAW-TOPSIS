---
import App from '../../layouts/App.astro';
import ActionNotice from '../../components/ActionNotice.astro';
import { actions } from 'astro:actions';

const user = Astro.locals.user!;
if (user.role !== 'admin') return Astro.redirect('/kriteria', 303);

const result = Astro.getActionResult(actions.criteria.save);
---

<App title="Kriteria baru" page="Kriteria" lead="Kriteria baru akan muncul di halaman penilaian setelah disimpan.">
  <div class="stack">
    <ActionNotice error={result?.error} />

    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title">Data kriteria</h2>
        <a class="button button--quiet" href="/kriteria">Kembali</a>
      </div>
      <div class="panel__body">
        <form method="post" action={actions.criteria.save} class="stack">
          <div class="form-grid">
            <div class="field">
              <label class="field__label" for="code">Kode</label>
              <input class="input" id="code" name="code" type="text" required maxlength="8" placeholder="C5" />
              <p class="field__hint">Maksimal 8 karakter, dipakai sebagai judul kolom matriks.</p>
            </div>
            <div class="field">
              <label class="field__label" for="weight">Bobot</label>
              <input class="input num" id="weight" name="weight" type="number" step="0.0001" min="0" max="100" required value="0" />
              <p class="field__hint">Contoh 0,3 atau 30. Boleh tidak berjumlah 1.</p>
            </div>
            <div class="field">
              <label class="field__label" for="direction">Arah</label>
              <select class="select" id="direction" name="direction" required>
                <option value="benefit">Benefit, makin besar makin baik</option>
                <option value="cost">Cost, makin kecil makin baik</option>
              </select>
            </div>
            <div class="field">
              <label class="field__label" for="sortOrder">Urutan tampil</label>
              <input class="input num" id="sortOrder" name="sortOrder" type="number" min="0" step="1" value="0" />
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="name">Nama kriteria</label>
            <input class="input" id="name" name="name" type="text" required maxlength="160" placeholder="Ketersediaan pembimbing" />
          </div>
          <div class="form-actions">
            <button class="button button--primary" type="submit">Simpan kriteria</button>
            <a class="button" href="/kriteria">Batal</a>
          </div>
        </form>
      </div>
    </section>
  </div>
</App>
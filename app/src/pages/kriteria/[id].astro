---
import App from '../../layouts/App.astro';
import ActionNotice from '../../components/ActionNotice.astro';
import { actions } from 'astro:actions';
import { db } from '../../lib/guard';
import { criteria } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user!;
if (user.role !== 'admin') return Astro.redirect('/kriteria', 303);

const idParam = Astro.params.id;
const isEdit = Boolean(idParam);
let current = { id: 0, code: '', name: '', weight: '0', direction: 'benefit' as 'benefit' | 'cost', sortOrder: 0 };

if (isEdit) {
  const [row] = await db.select().from(criteria).where(eq(criteria.id, Number(idParam))).limit(1);
  if (!row) return Astro.redirect('/kriteria', 303);
  current = {
    id: Number(row.id),
    code: row.code,
    name: row.name,
    weight: String(row.weight),
    direction: row.direction,
    sortOrder: row.sortOrder,
  };
}

const saveResult = Astro.getActionResult(actions.criteria.save);
---

<App title={isEdit ? 'Ubah kriteria' : 'Kriteria baru'} page="Kriteria" lead="Bobot boleh dalam skala apa pun. Sistem menormalkan otomatis dan memberi peringatan bila total bukan 1.">
  <div class="stack">
    <ActionNotice success={saveResult?.data ? 'Perubahan tersimpan.' : null} error={saveResult?.error} />

    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title">Data kriteria</h2>
        <a class="button button--quiet" href="/kriteria">Kembali</a>
      </div>
      <div class="panel__body">
        <form method="post" action={actions.criteria.save} class="stack">
          {isEdit && <input type="hidden" name="id" value={current.id} />}

          <div class="form-grid">
            <div class="field">
              <label class="field__label" for="code">Kode</label>
              <input class="input" id="code" name="code" type="text" required maxlength="8" value={current.code} placeholder="C1" />
              <p class="field__hint">Maksimal 8 karakter, dipakai sebagai judul kolom matriks.</p>
            </div>

            <div class="field">
              <label class="field__label" for="weight">Bobot</label>
              <input class="input num" id="weight" name="weight" type="number" step="0.0001" min="0" max="100" required value={current.weight} />
              <p class="field__hint">Contoh 0,3 atau 30. Boleh tidak berjumlah 1.</p>
            </div>

            <div class="field">
              <label class="field__label" for="direction">Arah</label>
              <select class="select" id="direction" name="direction" required>
                <option value="benefit" selected={current.direction === 'benefit'}>Benefit, makin besar makin baik</option>
                <option value="cost" selected={current.direction === 'cost'}>Cost, makin kecil makin baik</option>
              </select>
            </div>

            <div class="field">
              <label class="field__label" for="sortOrder">Urutan tampil</label>
              <input class="input num" id="sortOrder" name="sortOrder" type="number" min="0" step="1" value={current.sortOrder} />
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="name">Nama kriteria</label>
            <input class="input" id="name" name="name" type="text" required maxlength="160" value={current.name} placeholder="Relevansi tema dan judul" />
          </div>

          <div class="form-actions">
            <button class="button button--primary" type="submit">{isEdit ? 'Simpan perubahan' : 'Simpan kriteria'}</button>
            <a class="button" href="/kriteria">Batal</a>
          </div>
        </form>
      </div>
    </section>

    {isEdit && (
      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">Rubrik</h2>
          <p class="panel__meta">Pilihan cepat saat mengisi penilaian</p>
        </div>
        <div class="panel__body">
          <p class="muted small">
            Rubrik menyediakan label dan saran nilai untuk mempercepat pengisian. Nilai pada halaman penilaian tetap
            berupa angka bebas, jadi rubrik tidak mengunci apa pun.
          </p>
          <a class="button mt-4" href={`/kriteria/${current.id}/rubrik`}>Kelola rubrik</a>
        </div>
      </section>
    )}
  </div>
</App>
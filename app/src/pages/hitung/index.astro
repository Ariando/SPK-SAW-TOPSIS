---
import App from '../../layouts/App.astro';
import { loadMatrix, loadWeightOptions } from '../../lib/queries';
import { methods } from '../../lib/dss/registry';
import { formatNumber } from '../../lib/format';

// Pemilihan skenario dibaca dari query string, sehingga seluruh tautan
// "Hitung" di halaman ini membawa pilihan yang sama. Ini menghindari
// JavaScript dan tetap dapat di-bookmark serta dicetak.
const rawScenario = Astro.url.searchParams.get('skenario');
const requestedScenarioId = rawScenario ? Number(rawScenario) : null;

const options = await loadWeightOptions();
const usableScenarios = options.filter((o) => o.usable);

// Skenario yang diminta tetapi tidak layak tidak dipakai diam-diam.
const rejectedScenario =
  requestedScenarioId !== null
    ? usableScenarios.find((o) => o.id === requestedScenarioId) === undefined
      ? options.find((o) => o.id === requestedScenarioId) ?? null
      : null
    : null;

const activeScenarioId =
  requestedScenarioId !== null && usableScenarios.some((o) => o.id === requestedScenarioId)
    ? requestedScenarioId
    : null;

const matrix = await loadMatrix({ onlyActive: true, scenarioId: activeScenarioId });
const activeMethods = methods.filter((m) => m.inputMode === 'matrix');

const canCompute =
  matrix.missing.length === 0 &&
  matrix.input.criteria.length > 0 &&
  matrix.input.alternatives.length >= 2;

const scenarioQuery = activeScenarioId === null ? '' : '?skenario=' + activeScenarioId;
---

<App title="Hitung" page="Hitung" lead="Pilih metode. Semua metode memakai matriks nilai yang sama, sehingga hasilnya bisa dibandingkan.">
  <Fragment slot="actions">
    <a class="button button--quiet" href="/hasil/bandingkan">Bandingkan metode</a>
  </Fragment>

  <div class="stack">
    {!canCompute && (
      <div class="notice notice--warning" role="status">
        <span class="notice__title">Perhitungan belum bisa dijalankan</span>
        {matrix.missing.length > 0
          ? `Ada ${matrix.missing.length} sel nilai yang masih kosong.`
          : matrix.input.alternatives.length < 2
            ? 'Perlu minimal dua alternatif aktif untuk membandingkan.'
            : 'Data kriteria belum lengkap.'}
        <div class="cluster mt-4">
          <a class="button" href="/penilaian">Isi penilaian</a>
          <a class="button button--quiet" href="/alternatif">Kelola alternatif</a>
        </div>
      </div>
    )}

    {rejectedScenario && (
      <div class="notice notice--warning" role="status">
        <span class="notice__title">Skenario "{rejectedScenario.name}" tidak dapat dipakai</span>
        {!rejectedScenario.consistent
          ? 'Skenario ini ditandai tidak konsisten saat dibuat.'
          : !rejectedScenario.matchesCriteria
            ? 'Skenario dibuat dari susunan kriteria yang berbeda.'
            : 'Consistency Ratio skenario mencapai atau melewati ambang 0,1.'}
        Perhitungan di bawah memakai bobot kriteria, bukan bobot skenario itu.
        <div class="mt-4">
          <a class="button button--quiet" href="/hitung">Pakai bobot kriteria</a>
        </div>
      </div>
    )}

    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title" id="pilih-bobot">Bobot yang dipakai</h2>
        <p class="panel__meta">
          {matrix.weightSource.source === 'scenario' ? 'Skenario AHP' : 'Bobot kriteria'}
        </p>
      </div>
      <div class="panel__body">
        {usableScenarios.length === 0 ? (
          <p class="muted small">
            Belum ada skenario AHP yang layak dipakai. Bobot diambil dari master kriteria. Untuk memakai bobot AHP,
            buat skenario dengan CR di bawah 0,1 di <a href="/ahp">halaman AHP</a>.
          </p>
        ) : (
          <form method="get" action="/hitung" class="cluster">
            <div class="field" style="max-width: 34ch;">
              <label class="field__label" for="skenario">Sumber bobot</label>
              <select class="select" id="skenario" name="skenario">
                <option value="" selected={activeScenarioId === null}>Bobot kriteria</option>
                {usableScenarios.map((o) => (
                  <option value={o.id} selected={activeScenarioId === o.id}>
                    {o.name} (CR {formatNumber(o.consistencyRatio ?? 0, 4)})
                  </option>
                ))}
              </select>
              <p class="field__hint">
                Hanya skenario konsisten dan cocok dengan kriteria saat ini yang muncul di sini.
              </p>
            </div>
            <button class="button" type="submit">Terapkan</button>
          </form>
        )}

        {matrix.weightSource.source === 'scenario' && (
          <p class="notice notice--info mt-4" role="status">
            Memakai skenario <strong>{matrix.weightSource.scenarioName}</strong> dengan CR{' '}
            {formatNumber(matrix.weightSource.scenarioCr ?? 0, 4)}. Asal bobot ini akan tercatat pada hasil yang
            disimpan.
          </p>
        )}
      </div>
    </section>

    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title" id="tabel-metode">Metode tersedia</h2>
        <p class="panel__meta">{matrix.input.alternatives.length} alternatif · {matrix.input.criteria.length} kriteria</p>
      </div>
      <div class="panel__body">
        <div class="table-wrap">
          <table class="data-table" aria-labelledby="tabel-metode">
            <thead>
              <tr>
                <th scope="col">Metode</th>
                <th scope="col">Keterangan</th>
                <th scope="col"><span class="visually-hidden">Tindakan</span></th>
              </tr>
            </thead>
            <tbody>
              {activeMethods.map((m) => (
                <tr>
                  <th scope="row">
                    {m.label}
                    {m.higherIsBetter === false && (
                      <span class="muted small" style="display:block; font-weight:400;">nilai terkecil terbaik</span>
                    )}
                  </th>
                  <td class="muted small">{m.description}</td>
                  <td>
                    {canCompute ? (
                      <a class="button" href={`/hitung/${m.id}${scenarioQuery}`}>Hitung {m.label}</a>
                    ) : (
                      <span class="muted small">Menunggu data lengkap</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title" id="tabel-bobot-hitung">Bobot yang akan dipakai</h2>
      </div>
      <div class="panel__body panel__body--flush">
        <div class="table-wrap">
          <table class="data-table" aria-labelledby="tabel-bobot-hitung">
            <thead>
              <tr>
                <th scope="col">Kriteria</th>
                <th scope="col">Arah</th>
                <th scope="col" class="num">Bobot asli</th>
                <th scope="col" class="num">Bobot ternormalisasi</th>
              </tr>
            </thead>
            <tbody>
              {matrix.input.criteria.map((c) => (
                <tr>
                  <td><span class="matrix-tag">{c.code}</span> {c.name}</td>
                  <td>{c.direction === 'benefit' ? 'Benefit' : 'Cost'}</td>
                  <td class="num">{formatNumber(c.weight, 4)}</td>
                  <td class="num">
                    {matrix.weightSum > 0 ? formatNumber(c.weight / matrix.weightSum, 4) : '-'}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <td colspan="2">Total</td>
                <td class="num">{formatNumber(matrix.weightSum, 4)}</td>
                <td class="num">1,0000</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>
  </div>
</App>
---
interface Props {
  columns: string[];
  rows: (string | number)[][];
  caption?: string;
  numericFrom?: number;
  highlight?: boolean;
  dense?: boolean;
}

const { columns, rows, caption, numericFrom = 1, highlight = false, dense = false } = Astro.props;
const isNumeric = (index: number) => index >= numericFrom;
---

<div class="table-wrap">
  <table class:list={['data-table', { 'data-table--dense': dense }]}>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {columns.map((col, i) => (
          <th scope="col" class:list={{ num: isNumeric(i), 'matrix-tag-cell': i === 0 && highlight }}>
            {col}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, i) => (
            <td class:list={{ num: isNumeric(i) }}>
              {i === 0 && highlight ? <span class="matrix-tag">{cell}</span> : cell}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .data-table--dense th,
  .data-table--dense td {
    padding: 0.35rem 0.5rem;
    font-size: var(--step-1);
  }
</style>
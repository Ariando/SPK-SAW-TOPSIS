{
  "name": "telaah",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/reset-db.ts && drizzle-kit migrate && tsx scripts/seed.ts",
    "test:http": "node scripts/smoke-http.mjs",
    "test:crud": "node scripts/smoke-crud.mjs",
    "test:ui": "node scripts/verify-ui-numbers.mjs",
    "verify:all": "vitest run && node scripts/smoke-auth.mjs && node scripts/smoke-http.mjs && node scripts/smoke-p0.mjs && node scripts/smoke-crud.mjs && node scripts/verify-ui-numbers.mjs && tsx scripts/verify-snapshot-hash.mjs",
    "test:auth": "node scripts/smoke-auth.mjs",
    "test:p0": "node scripts/smoke-p0.mjs",
    "db:seed:viewer": "tsx scripts/seed-viewer.ts",
    "test:snapshot": "tsx scripts/verify-snapshot-hash.mjs"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.9",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
